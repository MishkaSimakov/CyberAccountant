# Node.js dependencies and framework caches
node_modules/
.next/
.nuxt/
.turbo/
.parcel-cache/
.svelte-kit/

# Python virtualenvs and tool caches
.venv/
/venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/

# Python package build output
/server/build/
/office_sandbox/build/

# Vite production output
/client/dist/

# Regenerable CI reports and container logs
/test-results/

# OCR output can be regenerated from the preserved originals.
/storage/*/*/versions/*/ocr/

# Canonical entities/ Markdown and edited/ revisions preserve assigned identities.
# They cannot be regenerated from OCR and must not be cleaned.

# Verification artifacts can be regenerated from the reviewed document revisions.
/storage/*/verification/
