FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OCR_WORKERS=1 \
    PYTHONPATH=/app/server

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-rus fonts-dejavu-core supervisor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/server
COPY workers.conf /etc/supervisor/workers.conf
COPY pyproject.toml ./
COPY app/ ./app/
COPY checkier/ ./checkier/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install '.[dev]'

WORKDIR /app
EXPOSE 8000

CMD ["sh", "-c", "database-init && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir /app/server"]
